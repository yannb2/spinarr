@* Green once the page is live (buttons work), grey while it is still connecting.
   The first render comes from the server as plain HTML; OnAfterRender only runs
   once the browser's connection to the server is up. *@
<span class="sv-connection small @(_live ? "live" : null)"
      title="@(_live ? "Connected to the server: buttons work." : "Not connected to the server yet: buttons do nothing until this turns green.")">
    <i class="bi bi-circle-fill me-1"></i><span class="sv-connection-text">@(_live ? "Live" : "Connecting…")</span>
</span>

@code {
    private bool _live;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _live = true;
            StateHasChanged();
        }
    }
}
