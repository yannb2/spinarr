@implements IDisposable
@inject ToolStatusService Tools
@inject IJSRuntime JS
@inject Spinarr.Rip.RipService Rips

<nav class="sv-sidebar @(_collapsed ? "collapsed" : "") @(MobileOpen ? "sv-mobile-open" : "")">
    <div class="sv-sidebar-header d-none d-md-flex">
        <a href="" class="d-flex align-items-center gap-2 text-decoration-none">
            <img src="favicon.svg" alt="" class="sv-logo"/>
            <span class="text-light fw-semibold sv-logo-text">Spinarr</span>
        </a>
    </div>

    <div class="sv-nav-content">
        <ul class="nav flex-column">
            <li class="nav-item">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="Close">
                    <i class="bi bi-vinyl"></i>
                    <span>Drives</span>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="rips" @onclick="Close">
                    <i class="bi bi-clock-history"></i>
                    <span>Rips@(_active > 0 ? $" ({_active})" : "")</span>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="logs" @onclick="Close">
                    <i class="bi bi-journal-text"></i>
                    <span>Logs</span>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="tools" @onclick="Close">
                    <i class="bi bi-tools"></i>
                    <span>Tools</span>
                    @if (Tools.UpdateCount > 0)
                    {
                        <span class="badge rounded-pill text-bg-info ms-auto" title="Newer tool versions">@Tools.UpdateCount</span>
                    }
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="settings" @onclick="Close">
                    <i class="bi bi-gear"></i>
                    <span>Settings</span>
                </NavLink>
            </li>
        </ul>
    </div>

    <div class="sv-sidebar-footer">
        <ul class="nav flex-column w-100">
            <li class="nav-item">
                <button class="nav-link w-100" @onclick="ToggleTheme" title="Switch to @(_dark ? "light" : "dark")">
                    <i class="bi @(_dark ? "bi-moon-fill" : "bi-sun-fill") sv-theme-icon @(_dark ? "" : "light")"></i>
                    <span>@(_dark ? "Dark" : "Light")</span>
                </button>
            </li>
        </ul>
        <div class="d-flex align-items-center justify-content-between sv-footer-meta">
            <span class="d-flex align-items-center gap-2">
                <ConnectionLight/>
                <a href="https://github.com/yannb2/spinarr" target="_blank" rel="noopener"
                   class="sv-version text-decoration-none">v@(AppInfo.Version)</a>
            </span>
            <button class="btn btn-link text-light p-0 sv-footer-btn d-none d-md-inline-flex"
                    @onclick="() => _collapsed = !_collapsed"
                    title="@(_collapsed ? "Expand" : "Collapse")">
                <i class="bi @(_collapsed ? "bi-chevron-right" : "bi-chevron-left")"></i>
            </button>
        </div>
    </div>
</nav>

@if (MobileOpen)
{
    <div class="sv-sidebar-backdrop d-md-none" @onclick="Close"></div>
}

@code {
    [Parameter] public bool MobileOpen { get; set; }
    [Parameter] public EventCallback<bool> MobileOpenChanged { get; set; }

    private bool _collapsed;

    /// <summary>The theme lives in the browser (localStorage); dark until the first render says otherwise.</summary>
    private bool _dark = true;

    private int _active;

    protected override void OnInitialized()
    {
        Tools.Changed += OnToolsChanged;
        Rips.Changed += OnRipChanged;
        _active = Rips.Jobs.Count(j => j.State == Spinarr.Rip.RipState.Running);
    }

    private void OnToolsChanged() => InvokeAsync(StateHasChanged);

    // A rip moves on many times a second: redraw only when the count of running rips changes.
    private void OnRipChanged(Spinarr.Rip.RipJob job)
    {
        var active = Rips.Jobs.Count(j => j.State == Spinarr.Rip.RipState.Running);
        if (active != _active)
        {
            _active = active;
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        Tools.Changed -= OnToolsChanged;
        Rips.Changed -= OnRipChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dark = await JS.InvokeAsync<string>("spinarrTheme.get") != "light";
            StateHasChanged();
        }
    }

    private async Task ToggleTheme() => _dark = await JS.InvokeAsync<string>("spinarrTheme.toggle") != "light";

    private async Task Close()
    {
        if (MobileOpen)
        {
            await MobileOpenChanged.InvokeAsync(false);
        }
    }
}
