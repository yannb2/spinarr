<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Version>0.1.0</Version>
        <InvariantGlobalization>false</InvariantGlobalization>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- The SDK only adds blazor.web.js when it sees .razor files at restore time.
             The Dockerfile restores from the .csproj alone, so say it here. -->
        <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Spinarr.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- Shared with Ripparr and Muxarr. A git submodule, see README. -->
        <ProjectReference Include="..\..\arrkit\src\Arrkit\Arrkit.csproj" />
    </ItemGroup>

</Project>
